<title>{{ title }}</title>
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<!-- Primary Metadata -->
<title>
  {% if title %}{{ title }}{% else %}Derek Best - Web Designer and Coder{% endif
  %}
</title>
<meta
  name="description"
  content="Skilled web designer and front-end developer with 20+ years of experience crafting visually stunning, responsive, and highly optimized digital experiences."
/>
<meta name="robots" content="index, follow" />
<meta name="author" content="Derek Best" />
<link rel="canonical" href="https://derekbest.design{{ page.url }}" />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content="https://derekbest.design{{ page.url }}" />
<meta property="og:title" content="Derek Best - Web Designer and Developer" />
<meta
  property="og:description"
  content="Skilled web designer and front-end developer with 20+ years of experience crafting visually stunning, responsive, and highly optimized digital experiences."
/>
<meta property="og:image" content="https://derekbest.design" />
<meta property="og:locale" content="en_US" />

<!-- Twitter / X -->
<meta name="twitter:card" content="summary_large_image" />
<meta property="twitter:domain" content="derekbest.design" />
<meta property="twitter:url" content="https://derekbest.design{{ page.url }}" />
<meta name="twitter:title" content="Derek Best - Web Designer and Developer" />
<meta
  name="twitter:description"
  content="Skilled web designer and front-end developer with 20+ years of experience crafting visually stunning, responsive, and highly optimized digital experiences."
/>
<meta name="twitter:image" content="https://derekbest.design" />

<!-- Icons & Assets -->
<link rel="icon" href="/favicon.ico" sizes="any" />
<link rel="apple-touch-icon" href="/icon.png" />
<link rel="stylesheet" href="/assets/scss/styles.css" />

<link
  rel="stylesheet"
  href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css"
/>
<link
  rel="stylesheet"
  href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.3.1/css/all.min.css"
  integrity="sha512-QeR2VH+lsBE5LSAe1Q5EnTBbe7XTBubt8dG93Y7gidSgdMCr8nVqKcfKAMyN96SV8KDbZVTDXChatu5G2KQGzg=="
  crossorigin="anonymous"
  referrerpolicy="no-referrer"
/>
